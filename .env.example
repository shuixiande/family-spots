# 复制本文件为 .env（本地开发）或在 Vercel → Settings → Environment Variables 中配置：
# 未配置时应用自动降级为 localStorage 本地模式（标注仅存本机）。

# Supabase 项目 URL 与匿名公钥（Dashboard → Project Settings → API）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 高德地图瓦片（国内显示用，GCJ-02）。留空则使用默认公共瓦片地址。
# 仅当地图中心位于中国大陆时启用高德瓦片，海外自动用 OSM(WGS-84)，坐标自动转换。
# 生产环境建议注册高德 Key 并替换为合规瓦片地址。
VITE_AMAP_TILE_URL=
